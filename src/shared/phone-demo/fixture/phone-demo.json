          "content": "Uploads that outlive their signed URL fail with a 403. Get a fresh URL and retry once.",
          "timestamp": "@now-900000"
        },
        {
          "id": "demo-done-a1",
          "role": "assistant",
          "content": "",
          "timestamp": "@now-880000",
          "toolCalls": [
            {
              "id": "demo-done-t1",
              "name": "Read",
              "input": "{\"file_path\":\"src/upload/putFile.ts\"}",
              "output": ""
            }
          ]
        },
        {
          "id": "demo-done-a2",
          "role": "assistant",
          "content": "Uploads that outlive their signed URL now get a fresh URL and one retry. Here is the flow:\n\n```mermaid\nflowchart LR\n  A[Upload] --> B[PUT to URL]\n  B -->|ok| C[Done]\n  B -->|403 expired| D[New URL, retry once]\n  D --> C\n```",
          "timestamp": "@now-760000"
        },
        {
          "id": "demo-done-f1",
          "role": "assistant",
          "content": "",
          "timestamp": "@now-750000",
          "fileDiff": {
            "fileEditId": "demo-done-turn:src/upload/putFile.ts",
            "repoRoot": "/demo/acme-console",
            "relPath": "src/upload/putFile.ts",
            "changeKind": "modify",
            "oldContent": "export async function putFile(url: string, body: Blob) {\n  const res = await fetch(url, { method: 'PUT', body })\n  if (!res.ok) throw new Error(`upload failed: ${res.status}`)\n  return res\n}\n",
            "newContent": "export async function putFile(key: string, url: string, body: Blob) {\n  let res = await fetch(url, { method: 'PUT', body })\n  if (res.status === 403) {\n    // The signed URL expired while the upload waited. Sign again, retry once.\n    url = await signUploadUrl(key)\n    res = await fetch(url, { method: 'PUT', body })\n  }\n  if (!res.ok) throw new Error(`upload failed: ${res.status}`)\n  return res\n}\n",
            "status": "accepted"
          }
        },
        {
          "id": "demo-done-f2",
          "role": "assistant",
          "content": "",
          "timestamp": "@now-750000",
          "fileDiff": {
            "fileEditId": "demo-done-turn:src/upload/sign.ts",
            "repoRoot": "/demo/acme-console",
            "relPath": "src/upload/sign.ts",
            "changeKind": "modify",
            "oldContent": "export async function signUploadUrl(key: string) {\n  const { url } = await api.post('/uploads/sign', { key })\n  return url\n}\n",
            "newContent": "export async function signUploadUrl(key: string): Promise<string> {\n  const { url } = await api.post('/uploads/sign', { key, ttlSeconds: 900 })\n  return url\n}\n",
            "status": "accepted"
          }
        },
        {
          "id": "demo-done-f3",
          "role": "assistant",
          "content": "",
          "timestamp": "@now-750000",
          "fileDiff": {
            "fileEditId": "demo-done-turn:test/upload.test.ts",
            "repoRoot": "/demo/acme-console",
            "relPath": "test/upload.test.ts",
            "changeKind": "add",
            "oldContent": "",
            "newContent": "import { putFile } from '../src/upload/putFile'\n\ntest('retries once with a fresh URL after a 403', async () => {\n  mockFetch([403, 200])\n  await putFile('a.png', 'https://bucket/old', new Blob(['x']))\n  expect(signUploadUrl).toHaveBeenCalledWith('a.png')\n})\n",
            "status": "accepted"
          }
        },
        {
