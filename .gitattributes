# Text files are stored and checked out with LF on every platform, so Windows
# CI (core.autocrlf) cannot turn fixtures and snapshots into CRLF and fail tests.
* text=auto eol=lf

# Windows batch files need CRLF to run.
*.bat text eol=crlf

# Binaries: never normalise or diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary
*.aab binary
*.apk binary
*.zip binary
*.gz binary
*.node binary
*.dylib binary
*.so binary

# Recorded host responses are byte-exact API output: keep them LF on every
# checkout (Windows autocrlf turned the raw diff into CRLF and broke its test).
tests/fixtures/pull-requests/** text eol=lf
