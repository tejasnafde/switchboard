{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/*.css",
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "apps/android/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "docs/**",
    "e2e/snapshots/**",
    "tests/fixtures/**",
    "videos/dist/**",
    "out/**",
    "release/**",
    "build/**",
    "coverage/**"
  ]
}
