{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@shared/*": [
        "../../src/shared/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "index.ts",
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../src/shared/**/*.ts"
  ]
}
