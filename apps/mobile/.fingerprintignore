# Paths excluded from the runtimeVersion fingerprint.
#
# The fingerprint must change when the NATIVE project changes and stay stable
# otherwise. Anything listed here is either generated from sources that are
# already hashed, or has no effect on the native build at all. A file that
# churns without changing native code would invalidate every installed APK's
# OTA targeting for no reason.

# Generated by prebuild from app.json plus the config plugins, all of which are
# already part of the hash. Including them would double-count and, worse, make
# the fingerprint depend on whether someone happened to run prebuild locally.
/android
/ios

# Test-only. Nothing here is bundled or compiled into the app.
**/__tests__/**
/src/test
jest.config.js
jest.setup.js

# Documentation and editor state.
*.md
.vscode
