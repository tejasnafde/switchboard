<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: TLS only, except loopback (this phone itself). A paired desktop is
  dialled over wss:// with its pinned certificate (PinnedTls.kt). The emulator's
  host address is deliberately absent: on a real phone it is an ordinary
  private address. Debug builds override this file in src/debug to keep plain
  ws:// for development (emulator and older desktops).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
