    {
      "id": "exact title, then starts with, then contains, each newest first",
      "query": "sync",
      "expected": [
        "sync-exact",
        "backoff",
        "jitter",
        "engine"
      ]
    },
    {
      "id": "case and extra spaces do not matter",
      "query": "  FIX   Sync ",
      "expected": [
        "jitter"
      ]
    },
    {
      "id": "project name matches come after title matches",
      "query": "switch",
      "expected": [
        "improvements",
        "parity",
        "engine"
      ]
    },
    {
      "id": "a project name match",
      "query": "bot",
      "expected": [
        "jitter",
        "review",
        "backoff"
      ]
    },
    {
      "id": "an older title match outranks a newer project match",
      "query": "tn07",
      "expected": [
        "launch",
        "landing"
      ]
    },
    {
      "id": "archived chats only with the archive word, which is not matched",
      "query": "sync archived",
      "expected": [
        "sync-exact",
        "backoff",
        "old-sync",
        "jitter",
        "engine"
      ]
    },
    {
      "id": "the archive word alone lists every chat, archived included",
      "query": "Archive",
      "expected": [
        "improvements",
        "old-sync",
        "jitter",
        "review",
        "backoff",
        "landing",
        "parity",
        "engine",
        "sync-exact",
        "old-misc",
        "launch"
      ]
    },
    {
      "id": "archive inside another word is an ordinary search",
      "query": "archives",
      "expected": []
    },
    {
      "id": "no match",
      "query": "zzz",
      "expected": []
    }
  ]
