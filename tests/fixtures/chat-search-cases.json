  "cases": [
    {
      "id": "empty query lists every live chat newest first",
      "query": "",
      "expected": [
        "improvements",
        "jitter",
        "review",
        "backoff",
        "landing",
        "parity",
        "engine",
        "sync-exact",
        "launch"
      ]
