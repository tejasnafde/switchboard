    }
  },
  {
    "name": "ready-resumed",
    "wire": "{\"k\":\"ready\",\"epoch\":\"epoch-a\",\"seq\":42,\"replayed\":2,\"gap\":false}",
    "expected": {
      "k": "ready",
      "epoch": "epoch-a",
      "seq": 42,
      "replayed": 2,
      "gap": false
    }
  },
  {
    "name": "request-send-turn",
    "wire": "{\"k\":\"req\",\"id\":7,\"ch\":\"provider:send-turn\",\"args\":[\"thread-same\",\"Ship it\",\"sandbox\",null,\"turn-text\"]}",
    "expected": {
      "k": "req",
      "id": 7,
      "ch": "provider:send-turn",
      "args": [
        "thread-same",
        "Ship it",
        "sandbox",
        null,
        "turn-text"
      ]
    }
  },
  {
    "name": "response-success",
    "wire": "{\"k\":\"res\",\"id\":7,\"ok\":true,\"result\":{\"accepted\":true}}",
    "expected": {
      "k": "res",
      "id": 7,
      "ok": true,
      "result": {
        "accepted": true
      }
    }
  },
  {
    "name": "response-failure",
    "wire": "{\"k\":\"res\",\"id\":8,\"ok\":false,\"error\":\"thread not found\"}",
    "expected": {
      "k": "res",
      "id": 8,
      "ok": false,
      "error": "thread not found"
    }
  },
  {
    "name": "send-viewing",
    "wire": "{\"k\":\"snd\",\"ch\":\"push:viewing\",\"args\":[\"ExponentPushToken[fixture]\",\"thread-same\"]}",
    "expected": {
