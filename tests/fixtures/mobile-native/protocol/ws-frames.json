          "threadId": "thread-same",
          "messageId": "assistant-1",
          "text": "Done",
          "streamKind": "assistant"
        }
      ],
      "seq": 42
    }
  },
  {
    "name": "ready-replay-gap",
    "wire": "{\"k\":\"ready\",\"epoch\":\"epoch-b\",\"seq\":0,\"replayed\":0,\"gap\":true}",
