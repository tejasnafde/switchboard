      "ch": "push:viewing",
      "args": [
        "ExponentPushToken[fixture]",
        "thread-same"
      ]
    }
  },
  {
    "name": "event-content",
    "wire": "{\"k\":\"evt\",\"ch\":\"provider:event\",\"args\":[{\"type\":\"content\",\"threadId\":\"thread-same\",\"messageId\":\"assistant-1\",\"text\":\"Done\",\"streamKind\":\"assistant\"}],\"seq\":42}",
    "expected": {
