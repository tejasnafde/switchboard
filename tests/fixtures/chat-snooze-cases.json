{
  "comment": "Snooze rules (src/shared/chat-snooze.ts, Kotlin ChatSnooze.kt). Times are local wall times YYYY-MM-DDTHH:MM[:SS] in the zone the test runs in. 2026-11-02 is a Monday.",
  "presets": [
    {
      "name": "Monday morning: all four, soonest first",
      "now": "2026-11-02T09:00",
      "expect": [
        ["Later today", "2026-11-02T12:00"],
        ["Tonight", "2026-11-02T20:00"],
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "a duration rounds up to the next :00 or :30",
      "now": "2026-11-02T09:10:30",
      "expect": [
        ["Later today", "2026-11-02T12:30"],
        ["Tonight", "2026-11-02T20:00"],
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "18:59: Later today would end at 22:00, Tonight is still more than an hour away",
      "now": "2026-11-02T18:59",
      "expect": [
        ["Tonight", "2026-11-02T20:00"],
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "19:00: Tonight is an hour away and drops",
      "now": "2026-11-02T19:00",
      "expect": [
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "17:29: Later today ends at 20:30, before 21:00",
      "now": "2026-11-02T17:29",
      "expect": [
        ["Tonight", "2026-11-02T20:00"],
        ["Later today", "2026-11-02T20:30"],
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "17:45: Later today would end at 21:00 and drops",
      "now": "2026-11-02T17:45",
      "expect": [
        ["Tonight", "2026-11-02T20:00"],
        ["Tomorrow morning", "2026-11-03T09:00"],
        ["Next week", "2026-11-09T09:00"]
      ]
    },
    {
      "name": "Sunday: Next week is tomorrow 09:00, the same minute as Tomorrow morning, which keeps it",
      "now": "2026-11-01T10:00",
      "expect": [
        ["Later today", "2026-11-01T13:00"],
        ["Tonight", "2026-11-01T20:00"],
        ["Tomorrow morning", "2026-11-02T09:00"]
      ]
    },
    {
      "name": "20:59 on the last day of the year: across the month and year",
      "now": "2026-12-31T20:59",
      "expect": [
        ["Tomorrow morning", "2027-01-01T09:00"],
        ["Next week", "2027-01-04T09:00"]
      ]
    },
    {
      "name": "21:00 Friday with custom presets: a two-day duration and a Saturday time",
      "now": "2026-11-06T21:00",
      "specs": [
        { "label": "In an hour", "kind": "duration", "minutes": 60 },
        { "label": "In 2 days", "kind": "duration", "minutes": 2880 },
        { "label": "Saturday noon", "kind": "weekday", "weekday": 6, "hour": 12, "minute": 0 }
      ],
      "expect": [
        ["Saturday noon", "2026-11-07T12:00"],
        ["In 2 days", "2026-11-08T21:00"]
      ]
    }
  ],
  "pick": [
    {
      "name": "a duration counts from the click",
      "shownAt": "2026-11-02T09:00",
      "label": "Later today",
      "clickAt": "2026-11-02T09:20",
      "expect": "2026-11-02T12:30"
    },
    {
      "name": "a clock time keeps the instant the menu showed, across midnight",
      "shownAt": "2026-11-02T23:59",
      "label": "Tomorrow morning",
      "clickAt": "2026-11-03T00:01",
      "expect": "2026-11-03T09:00"
    },
    {
      "name": "a clock time that has passed is refused",
      "shownAt": "2026-11-02T09:00",
      "label": "Tonight",
      "clickAt": "2026-11-02T20:00",
      "expect": "past"
    }
  ],
  "wakeLabel": [
    { "now": "2026-11-02T10:00", "until": "2026-11-02T20:00", "pr": null, "expect": "20:00" },
    { "now": "2026-11-02T10:00", "until": "2026-11-03T09:00", "pr": null, "expect": "Tue 09:00" },
    { "now": "2026-11-02T10:00", "until": "2026-11-08T23:00", "pr": null, "expect": "Sun 23:00" },
    { "now": "2026-11-02T10:00", "until": "2026-11-09T09:00", "pr": null, "expect": "9 Nov" },
    { "now": "2026-11-02T10:00", "until": "2027-01-12T09:00", "pr": null, "expect": "12 Jan" },
    { "now": "2026-11-02T10:00", "until": null, "pr": "acme/app#512", "expect": "PR #512" },
    { "now": "2026-11-02T10:00", "until": "2026-11-02T20:00", "pr": "acme/app#512", "expect": "20:00" }
  ],
  "customWake": [
    { "now": "2026-11-02T10:00", "date": [2026, 11, 2], "clock": "09:00", "expect": "past" },
    { "now": "2026-11-02T10:00", "date": [2026, 11, 2], "clock": "10:30", "expect": "ok", "at": "2026-11-02T10:30" },
    { "now": "2026-11-02T10:00", "date": [2026, 11, 3], "clock": "9:05", "expect": "ok", "at": "2026-11-03T09:05" },
    { "now": "2026-11-02T10:00", "date": [2027, 2, 30], "clock": "09:00", "expect": "no_such_date" },
    { "now": "2026-11-02T10:00", "date": [2027, 4, 31], "clock": "09:00", "expect": "no_such_date" },
    { "now": "2026-11-02T10:00", "date": [2026, 11, 3], "clock": "25:00", "expect": "bad_clock" },
    { "now": "2026-11-02T10:00", "date": [2026, 11, 3], "clock": "-1:00", "expect": "bad_clock" },
    { "now": "2026-11-02T10:00", "date": [2026, 11, 3], "clock": "9:5", "expect": "bad_clock" },
    { "now": "2026-11-02T10:00", "date": [2027, 11, 3], "clock": "09:00", "expect": "too_far" }
  ],
  "customWakeDst": [
    {
      "comment": "2027-03-14 02:30 does not exist; 2026-11-01 01:30 happens twice and takes the first (EDT).",
      "zone": "America/New_York",
      "now": 1793491200000,
      "cases": [
        { "date": [2027, 3, 14], "clock": "02:30", "expect": "no_such_time" },
        { "date": [2027, 3, 14], "clock": "03:30", "expect": "ok", "epochMs": 1805009400000 },
        { "date": [2026, 11, 1], "clock": "01:30", "expect": "ok", "epochMs": 1793511000000 },
        { "date": [2027, 2, 29], "clock": "09:00", "expect": "no_such_date" }
      ]
    },
    {
      "comment": "2027-03-28 01:30 does not exist; 2026-10-25 01:30 happens twice and takes the first (BST).",
      "zone": "Europe/London",
      "now": 1792454400000,
      "cases": [
        { "date": [2027, 3, 28], "clock": "01:30", "expect": "no_such_time" },
        { "date": [2027, 3, 28], "clock": "02:30", "expect": "ok", "epochMs": 1806197400000 },
        { "date": [2026, 10, 25], "clock": "01:30", "expect": "ok", "epochMs": 1792888200000 }
      ]
    }
  ],
  "shouldWakeOn": [
    { "name": "the time passed", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "time", "now": 1000 }, "expect": "time" },
    { "name": "the time has not passed", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "time", "now": 999 }, "expect": null },
    { "name": "a PR-only snooze has no time", "state": { "snoozedUntil": null, "snoozedAt": 500, "snoozePr": "a/b#1" }, "event": { "kind": "time", "now": 99999 }, "expect": null },
    { "name": "a card opened", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "needs_you" }, "expect": "needs_you" },
    { "name": "a failure after the snooze", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "error", "at": 501 }, "expect": "error" },
    { "name": "a failure from before the snooze (replayed or late)", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "error", "at": 500 }, "expect": null },
    { "name": "a message a person sent", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "message", "from": "person", "at": 501 }, "expect": "message" },
    { "name": "a message a person sent before the snooze, delivered after it", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "message", "from": "person", "at": 500 }, "expect": null },
    { "name": "a message from an agent", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "message", "from": "agent", "at": 501 }, "expect": null },
    { "name": "a normal turn end", "state": { "snoozedUntil": 1000, "snoozedAt": 500 }, "event": { "kind": "turn_completed" }, "expect": null },
    { "name": "the watched PR changed", "state": { "snoozedUntil": null, "snoozedAt": 500, "snoozePr": "a/b#1" }, "event": { "kind": "pr", "pr": "a/b#1" }, "expect": "pr" },
    { "name": "another PR changed", "state": { "snoozedUntil": null, "snoozedAt": 500, "snoozePr": "a/b#1" }, "event": { "kind": "pr", "pr": "a/b#2" }, "expect": null },
    { "name": "not snoozed", "state": { "snoozedUntil": null, "snoozedAt": null }, "event": { "kind": "needs_you" }, "expect": null }
  ],
  "parsePreset": [
    { "raw": { "label": "Lunch", "kind": "time", "dayOffset": 0, "hour": 13, "minute": 0 }, "ok": true },
    { "raw": { "label": "  ", "kind": "duration", "minutes": 60 }, "ok": false },
    { "raw": { "label": "Soon", "kind": "duration", "minutes": 4 }, "ok": false },
    { "raw": { "label": "Bad hour", "kind": "time", "dayOffset": 0, "hour": 24, "minute": 0 }, "ok": false },
    { "raw": { "label": "Bad day", "kind": "weekday", "weekday": 7, "hour": 9, "minute": 0 }, "ok": false },
    { "raw": { "label": "Friday", "kind": "weekday", "weekday": 5, "hour": 17, "minute": 30 }, "ok": true },
    { "raw": { "label": "Odd", "kind": "month", "hour": 9, "minute": 0 }, "ok": false }
  ],
  "prWake": [
    { "name": "nothing changed", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "expect": null },
    { "name": "merged", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "merged", "updatedAt": 200, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "expect": "PR #512 merged" },
    { "name": "closed without a merge does not wake", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "closed", "updatedAt": 200, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "expect": null },
    { "name": "changes requested after the newest one at the mark", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": 1000 }, "reading": { "number": 512, "state": "open", "updatedAt": 1001, "headSha": "a1", "checksFailed": false, "changesRequestedAt": 1001 }, "expect": "PR #512: changes requested" },
    { "name": "the same changes request as at the mark", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": 1000 }, "reading": { "number": 512, "state": "open", "updatedAt": 1500, "headSha": "a1", "checksFailed": false, "changesRequestedAt": 1000 }, "expect": null },
    { "name": "a first changes request", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 150, "headSha": "a1", "checksFailed": false, "changesRequestedAt": 150 }, "expect": "PR #512: changes requested" },
    { "name": "checks failed", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 200, "headSha": "a1", "checksFailed": true, "changesRequestedAt": null }, "expect": "PR #512: checks failed" },
    { "name": "checks already failed on that head", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": true, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 200, "headSha": "a1", "checksFailed": true, "changesRequestedAt": null }, "expect": null },
    { "name": "checks failed again on a new push", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": true, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 200, "headSha": "b2", "checksFailed": true, "changesRequestedAt": null }, "expect": "PR #512: checks failed" },
    { "name": "a new push alone does not wake", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 200, "headSha": "b2", "checksFailed": false, "changesRequestedAt": null }, "expect": null },
    { "name": "comments and an approval (only the update time moved) do not wake", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 900, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "expect": null },
    { "name": "a merge outranks the rest", "mark": { "state": "open", "updatedAt": 100, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "merged", "updatedAt": 2000, "headSha": "a1", "checksFailed": true, "changesRequestedAt": 2000 }, "expect": "PR #512 merged" },
    { "name": "a cached read older than the mark does not wake", "mark": { "state": "open", "updatedAt": 500, "headSha": "b2", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": 400, "headSha": "a1", "checksFailed": true, "changesRequestedAt": 400 }, "expect": null },
    { "name": "a read with no update time still compares forward", "mark": { "state": "open", "updatedAt": null, "headSha": "a1", "checksFailed": false, "changesRequestedAt": null }, "reading": { "number": 512, "state": "open", "updatedAt": null, "headSha": "a1", "checksFailed": true, "changesRequestedAt": null }, "expect": "PR #512: checks failed" }
  ],
  "shelfOrder": [
    { "name": "the soonest wake first", "rows": [{ "id": "b", "until": "2026-11-03T09:00" }, { "id": "a", "until": "2026-11-02T20:00" }], "expect": ["a", "b"] },
    { "name": "PR-only snoozes last, in list order", "rows": [{ "id": "p1", "until": null }, { "id": "t", "until": "2026-11-09T09:00" }, { "id": "p2", "until": null }], "expect": ["t", "p1", "p2"] },
    { "name": "the same wake keeps list order", "rows": [{ "id": "x", "until": "2026-11-02T20:00" }, { "id": "y", "until": "2026-11-02T20:00" }], "expect": ["x", "y"] }
  ],
  "snoozeLine": [
    { "now": "2026-11-02T10:00", "until": "2026-11-02T20:00", "pr": null, "expect": "Snoozed until 20:00" },
    { "now": "2026-11-02T10:00", "until": "2026-11-03T09:00", "pr": "github:acme/app#512", "expect": "Snoozed until Tue 09:00" },
    { "now": "2026-11-02T10:00", "until": null, "pr": "github:acme/app#512", "expect": "Snoozed until PR #512 changes" },
    { "now": "2026-11-02T10:00", "until": null, "pr": null, "expect": "Snoozed" }
  ],
  "snoozePr": [
    { "name": "the newest link that is still open", "links": [{ "number": 1, "linkedAt": 1, "state": "open" }, { "number": 2, "linkedAt": 3, "state": "merged" }, { "number": 3, "linkedAt": 2, "state": null }], "expect": { "key": "github:acme/app#3", "number": 3 } },
    { "name": "no open link", "links": [{ "number": 2, "linkedAt": 3, "state": "closed" }], "expect": null }
  ],
  "refusal": {
    "needs_you": "A chat that needs you cannot be snoozed",
    "past": "That time has passed. Pick another",
    "too_far": "Pick a time within a year",
    "pr_closed": "That pull request is closed",
    "pr_unlinked": "That pull request is not linked to this chat",
    "pr_unreadable": "The pull request could not be read",
    "stale": "The chat changed since. Nothing to undo",
    "empty": "Pick a time",
    "no_row": "This chat cannot be snoozed"
  }
