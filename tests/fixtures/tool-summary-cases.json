  {
    "id": "task-long-prompt",
    "toolName": "task",
    "input": {
      "prompt": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "expected": {
      "label": "Subagent",
      "detail": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…"
    },
    "android": false,
    "note": "The shared TS module caps a Task/Subagent detail at 80 chars (mobile's original rule); native Android applies one uniform 140-char cap to every tool detail (pre-existing, tested in ThreadPresentationTest.everyToolDetailNormalizesWhitespaceAndStopsAt140Characters). Not worth a special-cased length just for this one tool kind."
  },
