[
  {
    "id": "nothing-to-draw",
    "markdown": "Hello\n\n```ts\nconst a = 1\n```\n",
    "expected": [
      {
        "kind": "markdown",
        "text": "Hello\n\n```ts\nconst a = 1\n```\n"
      }
    ]
  },
  {
    "id": "mermaid-and-chart",
    "markdown": "Before\n```mermaid\ngraph TD\nA-->B\n```\nMiddle\n~~~~ chart extra\n{\"a\":1}\n~~~~\nAfter",
    "expected": [
      {
        "kind": "markdown",
        "text": "Before"
      },
      {
        "kind": "mermaid",
        "source": "graph TD\nA-->B"
      },
      {
        "kind": "markdown",
        "text": "Middle"
      },
      {
        "kind": "chart",
        "source": "{\"a\":1}"
      },
      {
        "kind": "markdown",
        "text": "After"
      }
    ]
  },
  {
    "id": "still-streaming",
    "markdown": "Look:\n```mermaid\ngraph TD\nA-->",
    "expected": [
      {
        "kind": "markdown",
        "text": "Look:\n```mermaid\ngraph TD\nA-->"
      }
    ]
  },
  {
    "id": "closing-fence-too-short",
    "markdown": "````mermaid\ngraph TD\n```\n",
    "expected": [
      {
        "kind": "markdown",
        "text": "````mermaid\ngraph TD\n```\n"
      }
    ]
  },
  {
    "id": "closing-fence-other-character",
    "markdown": "```mermaid\ngraph TD\n~~~\n",
    "expected": [
      {
        "kind": "markdown",
        "text": "```mermaid\ngraph TD\n~~~\n"
      }
    ]
  },
  {
    "id": "info-string-case-and-longer-close",
    "markdown": "```Mermaid\ngraph TD\n````\n",
    "expected": [
      {
        "kind": "mermaid",
        "source": "graph TD"
      }
    ]
  },
  {
    "id": "inside-another-fence",
    "markdown": "````markdown\n```mermaid\ngraph TD\n```\n````",
    "expected": [
      {
        "kind": "markdown",
        "text": "````markdown\n```mermaid\ngraph TD\n```\n````"
      }
    ]
  },
  {
    "id": "inside-a-quote",
    "markdown": "> ```mermaid\n> graph TD\n> ```",
    "expected": [
      {
        "kind": "markdown",
        "text": "> ```mermaid\n> graph TD\n> ```"
      }
    ]
  },
  {
    "id": "indented-code",
    "markdown": "    ```mermaid\n    graph TD\n    ```",
    "expected": [
      {
        "kind": "markdown",
        "text": "    ```mermaid\n    graph TD\n    ```"
      }
    ]
  },
  {
    "id": "three-space-indent",
    "markdown": "   ```chart\n{}\n   ```",
    "expected": [
      {
        "kind": "chart",
        "source": "{}"
      }
    ]
  },
  {
    "id": "empty-block",
    "markdown": "```chart\n\n```",
    "expected": [
      {
        "kind": "markdown",
        "text": "```chart\n\n```"
      }
    ]
  },
  {
    "id": "backtick-in-info-string",
    "markdown": "```mermaid `x`\ngraph TD\n```",
    "expected": [
      {
        "kind": "markdown",
        "text": "```mermaid `x`\ngraph TD\n```"
      }
    ]
  },
  {
    "id": "crlf",
    "markdown": "```mermaid\r\ngraph TD\r\n```\r\n",
    "expected": [
      {
        "kind": "mermaid",
        "source": "graph TD"
      }
    ]
  },
  {
    "id": "chartjs-is-not-chart",
    "markdown": "```chartjs\n{}\n```",
    "expected": [
      {
        "kind": "markdown",
        "text": "```chartjs\n{}\n```"
      }
    ]
  },
  {
    "id": "html-live-closed-with-title",
    "markdown": "Look\n```html-live title=\"p95 latency\"\n<script src=\"/_sb/chart.js\"></script>\n<canvas id=\"c\"></canvas>\n```\nDone",
    "expected": [
      {
        "kind": "markdown",
        "text": "Look"
      },
      {
        "kind": "html-live",
        "source": "<script src=\"/_sb/chart.js\"></script>\n<canvas id=\"c\"></canvas>",
        "title": "p95 latency",
        "closed": true
      },
      {
        "kind": "markdown",
        "text": "Done"
      }
    ]
  },
  {
    "id": "html-live-still-streaming",
    "markdown": "Writing:\n```html-live\n<div>\n<p>par",
    "expected": [
      {
        "kind": "markdown",
        "text": "Writing:"
      },
      {
        "kind": "html-live",
        "source": "<div>\n<p>par",
        "title": null,
        "closed": false
      }
    ]
  },
  {
    "id": "html-live-case-and-single-quotes",
    "markdown": "~~~ HTML-Live title='Tide gauge'\n<b>x</b>\n~~~",
    "expected": [
      {
        "kind": "html-live",
        "source": "<b>x</b>",
        "title": "Tide gauge",
        "closed": true
      }
    ]
  },
  {
    "id": "html-live-empty-title",
    "markdown": "```html-live title=\"  \"\n<b>x</b>\n```",
    "expected": [
      {
        "kind": "html-live",
        "source": "<b>x</b>",
        "title": null,
        "closed": true
      }
    ]
  },
  {
    "id": "html-live-empty-block",
    "markdown": "```html-live\n\n```",
    "expected": [
      {
        "kind": "markdown",
        "text": "```html-live\n\n```"
      }
    ]
  },
  {
    "id": "html-other-language",
    "markdown": "```html\n<b>x</b>\n```",
    "expected": [
      {
        "kind": "markdown",
        "text": "```html\n<b>x</b>\n```"
      }
    ]
  }
]
